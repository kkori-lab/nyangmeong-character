# 키 목록. 실제 값은 .env.local(git 제외)에 넣는다. 2번 서버는 시크릿 ENV_FILE
# Java 내부 API 주소(로컬: 백엔드 bootRun 주소 또는 contract/fake_java.py 주소)
BACKEND_BASE_URL=
# OpenAI 키 : 비면 캐릭터 생성 API 502
OPENAI_API_KEY=
# OpenAI 주소(비우면 https://api.openai.com/v1) : 대조 테스트가 가짜 OpenAI로 돌릴 때만
OPENAI_BASE_URL=
CHARACTER_IMAGE_MODEL=gpt-image-2
CHARACTER_VISION_MODEL=gpt-5-nano
CHARACTER_TIMEOUT_SEC=180
